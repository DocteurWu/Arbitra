[Unit]
Description=Arbitra — AI dispute arbitration (Next.js)
After=network.target

[Service]
Type=simple
User=dietpi
WorkingDirectory=/home/dietpi/Arbitra
ExecStart=/usr/local/bin/npm run start -- -p 3000
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target