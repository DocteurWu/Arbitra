# ── IA (au moins une clé ; ordre de priorité : Anthropic > DeepSeek > OpenAI > simulateur local) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Comptes + base de données (Supabase) — laisse vide pour le mode local ouvert, sans comptes ──
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mettre à 1 une fois le fournisseur Google activé dans Supabase > Authentication > Providers
NEXT_PUBLIC_GOOGLE_AUTH=

# ── Paiement (Stripe) ──
# Développeurs > Clés API (sk_test_… en mode test ; en production, préférer une clé restreinte rk_live_…)
STRIPE_SECRET_KEY=
# Fourni par `stripe listen` en local, ou par le endpoint du webhook en production (whsec_…)
STRIPE_WEBHOOK_SECRET=

# ── Catalogue Stripe (optionnel) ──
# Price IDs des produits créés dans le dashboard. Si vide, les prix de src/lib/plans.ts sont
# envoyés à Stripe à la volée (price_data) — aucune config dashboard nécessaire.
# En mode test et en mode live les IDs diffèrent : renseigner la série correspondant à la clé.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK5=
STRIPE_PRICE_PACK15=
STRIPE_PRICE_MONTHLY=
